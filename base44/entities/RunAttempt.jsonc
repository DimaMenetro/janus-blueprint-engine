{
  "name": "RunAttempt",
  "type": "object",
  "properties": {
    "run_id": {
      "type": "string"
    },
    "stage_id": {
      "type": "string",
      "description": "RunStage revision this attempt executed"
    },
    "stage_key": {
      "type": "string"
    },
    "attempt_number": {
      "type": "number"
    },
    "orchestrator": {
      "type": "string",
      "description": "browser (transitional) or workflow (production target)"
    },
    "model_policy": {
      "type": "string",
      "description": "Model policy in force; calls inherit the operator's Claude Opus setting"
    },
    "claim_state": {
      "type": "string",
      "enum": [
        "unclaimed",
        "claimed",
        "void"
      ],
      "enumColors": [
        "gray",
        "blue",
        "red"
      ],
      "description": "Single-call guarantee. The server claims an attempt atomically before the model call; a claimed or void attempt can never start a call again."
    },
    "claimed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the server claimed the attempt. Telemetry only, never failure evidence."
    },
    "transport": {
      "type": "object",
      "description": "What the server recorded when the model call settled. The only evidence used to resolve an attempt whose session is gone.",
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "returned",
            "failed"
          ]
        },
        "evidence": {
          "type": "string",
          "description": "Failure evidence class when state is failed"
        },
        "message": {
          "type": "string"
        },
        "http_status": {
          "type": "number"
        },
        "recorded_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "response_text": {
      "type": "string",
      "description": "The model's returned result exactly as received, recorded by the server"
    },
    "outcome": {
      "type": "string",
      "enum": [
        "in_flight",
        "succeeded",
        "provider_error",
        "transport_settled_failure",
        "platform_termination",
        "parse_failure",
        "schema_failure",
        "quota_failure",
        "operator_cancellation",
        "not_started"
      ],
      "default": "in_flight",
      "description": "Actual settled outcome. in_flight means a provider request may still be live. not_started means no model call was ever made for this attempt."
    },
    "settled_by": {
      "type": "string",
      "description": "session (the session that awaited the call) or recovery (a later session, from the server's record)"
    },
    "error_message": {
      "type": "string"
    },
    "retry_decision": {
      "type": "string",
      "enum": [
        "none",
        "retry_scheduled",
        "exhausted"
      ],
      "default": "none"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "ended_at": {
      "type": "string",
      "format": "date-time"
    },
    "elapsed_ms": {
      "type": "number",
      "description": "Telemetry only \u2014 never failure evidence"
    }
  },
  "required": [
    "run_id",
    "stage_id",
    "stage_key",
    "attempt_number",
    "outcome"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}